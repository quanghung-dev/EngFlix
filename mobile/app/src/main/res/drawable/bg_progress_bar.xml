<?xml version="1.0" encoding="utf-8"?>
<!-- drawable/bg_progress_bar.xml
     Custom progress bar cho màn hình học tập và detail -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Track (nền) -->
    <item android:id="@android:id/background">
        <shape android:shape="rectangle">
            <solid android:color="@color/progress_track" />
            <corners android:radius="@dimen/progress_corner_radius" />
        </shape>
    </item>
    <!-- Fill (phần hoàn thành) -->
    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <solid android:color="@color/progress_fill" />
                <corners android:radius="@dimen/progress_corner_radius" />
            </shape>
        </clip>
    </item>
</layer-list>
