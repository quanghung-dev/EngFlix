<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="#F2F2F7">

    <!-- Toolbar -->
    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@android:color/transparent"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:navigationIconTint="#1A1A2E"
        app:title="Thêm ghi chú"
        app:titleTextColor="#1A1A2E"
        app:titleTextAppearance="@style/TextAppearance.AppCompat.Title" />

    <!-- Card: Câu -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardSentence"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="16dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Câu -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#DDEEFF"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="≡"
                        android:textSize="18sp"
                        android:textColor="#4A90D9" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Câu"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

            </LinearLayout>

            <!-- Sentence Text (English) -->
            <TextView
                android:id="@+id/tvSentenceEn"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="Have you ever noticed something swimming in your field of vision?"
                android:textSize="15sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:background="#F2F2F7"
                android:padding="12dp"
                android:layout_marginBottom="10dp" />

            <!-- Phonetic (To match Edit page, though not originally in Add page, we can leave it out or add placeholder. I will skip it to keep Add simple, or add it to be fully in sync. The prompt said "đồng bộ", let's include it but hidden or empty? No, original had no phonetic. I will just align the Vietnamese part.) -->

            <!-- Sentence Text (Vietnamese) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🌐"
                    android:textSize="13sp"
                    android:layout_marginEnd="6dp" />

                <TextView
                    android:id="@+id/tvSentenceVi"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Bạn đã bao giờ nhận thấy thứ gì đó bơi trong tầm nhìn của mình chưa?"
                    android:textSize="13sp"
                    android:textColor="#888888" />

            </LinearLayout>

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Card: Ghi chú -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardNote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="14dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="@android:color/white">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Header Ghi chú -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:background="#F5E6FF"
                    android:gravity="center"
                    android:layout_marginEnd="10dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="✏"
                        android:textSize="16sp"
                        android:textColor="#9B59B6" />

                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ghi chú của bạn"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#1A1A1A" />

            </LinearLayout>

            <!-- Note Input -->
            <EditText
                android:id="@+id/etNote"
                android:layout_width="match_parent"
                android:layout_height="150dp"
                android:hint="Viết ghi chú của bạn về câu này..."
                android:textColorHint="#C7C7CC"
                android:textSize="15sp"
                android:textColor="#1A1A1A"
                android:background="#F2F2F7"
                android:padding="12dp"
                android:gravity="top|start"
                android:inputType="textMultiLine"
                android:maxLines="6" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Button: Tạo ghi chú -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="20dp"
        app:cardElevation="4dp"
        app:cardBackgroundColor="#4A90D9">

        <TextView
            android:id="@+id/btnCreateNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="✔  Tạo ghi chú"
            android:textSize="16sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:paddingTop="16dp"
            android:paddingBottom="16dp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>