<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_chinh_ta.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- ===== TOOLBAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Nút X -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_btn_circle_gray"
            android:contentDescription="close" />

        <!-- Title + progress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINCESS MONONOKE | Official..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% hoàn thành"
                android:textSize="12sp"
                android:textColor="#888888" />

        </LinearLayout>

        <!-- Timer badge -->
        <LinearLayout
            android:id="@+id/badgeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_timer"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_clock_circle"
                android:layout_marginEnd="4dp"
                android:contentDescription="timer" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:06"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2196F3" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- ===== VIDEO CỐ ĐỊNH (không scroll) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="210dp">

        <WebView
            android:id="@+id/webViewYoutube"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- ===== SCROLL CONTENT (từ controls trở xuống) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Controls row: Dừng tự động / speed / settings / list -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dừng tự động"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Speed button -->
                <LinearLayout
                    android:id="@+id/btnSpeed"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_pill_gray"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="6dp"
                    android:paddingBottom="6dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_speed"
                        android:layout_marginEnd="4dp"
                        android:contentDescription="speed" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="1.0x"
                        android:textSize="13sp"
                        android:textColor="#1A1A1A" />

                </LinearLayout>

                <!-- Settings -->
                <ImageButton
                    android:id="@+id/btnSettings"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_settings"
                    android:background="@drawable/bg_btn_circle_gray"
                    android:contentDescription="settings"
                    android:layout_marginEnd="8dp" />

                <!-- List/transcript -->
                <ImageButton
                    android:id="@+id/btnTranscript"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_list"
                    android:background="@drawable/bg_btn_circle_gray"
                    android:contentDescription="transcript" />

            </LinearLayout>

            <!-- ===== SENTENCE SELECTOR (số câu) ===== -->

            <!-- ===== WORD CARDS (câu bị ẩn) ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSentenceNumbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvItemCard"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:orientation="horizontal"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp" />



        </LinearLayout>

    </ScrollView>

    <!-- ===== BOTTOM BUTTON ===== -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:visibility="visible"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="8dp"
        android:text="Bắt đầu"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_btn_blue_fill"
        android:stateListAnimator="@null" />
    <LinearLayout
        android:id="@+id/layoutButtonBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="16dp"
        android:gravity="center"
        android:background="@color/white">

        <!-- Button Trước (Previous) -->
        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_btn_circle_gray"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="Previous" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Button Mic -->
        <ImageButton
            android:id="@+id/btnMic"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:src="@drawable/ic_mic"
            android:background="@drawable/bg_icon_circle_blue"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="Record" />

        <Space
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1" />

        <!-- Button Sau (Next) -->
        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/ic_arrow_forward"
            android:background="@drawable/bg_btn_circle_gray"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="Next" />

    </LinearLayout>

</LinearLayout>