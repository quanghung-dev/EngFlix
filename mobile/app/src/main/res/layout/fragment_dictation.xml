<?xml version="1.0" encoding="utf-8"?>
<!-- res/layout/fragment_chinh_ta.xml -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/white">

    <!-- ===== TOOLBAR ===== -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="12dp"
        android:paddingEnd="16dp">

        <!-- Nút X -->
        <ImageButton
            android:id="@+id/btnClose"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:src="@drawable/ic_close"
            android:background="@drawable/bg_btn_circle_gray"
            android:contentDescription="close" />

        <!-- Title + progress -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp">

            <TextView
                android:id="@+id/tvToolbarTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINCESS MONONOKE | Official..."
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:maxLines="1"
                android:ellipsize="end" />

            <TextView
                android:id="@+id/tvProgress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="0% hoàn thành"
                android:textSize="12sp"
                android:textColor="#888888" />

        </LinearLayout>

        <!-- Timer badge -->
        <LinearLayout
            android:id="@+id/badgeTimer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/bg_badge_timer"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp">

            <ImageView
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:src="@drawable/ic_clock_circle"
                android:layout_marginEnd="4dp"
                android:contentDescription="timer" />

            <TextView
                android:id="@+id/tvTimer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00:06"
                android:textSize="13sp"
                android:textStyle="bold"
                android:textColor="#2196F3" />

        </LinearLayout>

    </LinearLayout>

    <!-- Divider -->
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="#EEEEEE" />

    <!-- ===== VIDEO CỐ ĐỊNH (không scroll) ===== -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="210dp">

        <WebView
            android:id="@+id/webViewYoutube"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </FrameLayout>

    <!-- ===== SCROLL CONTENT (từ controls trở xuống) ===== -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Controls row: Dừng tự động / speed / settings / list -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingTop="12dp"
                android:paddingBottom="12dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Dừng tự động"
                    android:textSize="13sp"
                    android:textColor="#1A1A1A"
                    android:layout_marginEnd="8dp" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchAutoStop"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <Space
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />

                <!-- Speed button -->
                <LinearLayout
                    android:id="@+id/btnSpeed"
                    android:layout_width="92dp"
                    android:layout_height="36dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:background="@drawable/bg_speed_button"
                    android:foreground="?attr/selectableItemBackground"
                    android:paddingStart="12dp"
                    android:paddingEnd="10dp"
                    android:layout_marginEnd="8dp"
                    android:clickable="true"
                    android:focusable="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/ic_speed"
                        android:tint="#2877C9"
                        android:layout_marginEnd="6dp"
                        android:contentDescription="speed" />

                    <TextView
                        android:id="@+id/tvSpeed"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="1.0x"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:textColor="#164F86" />

                    <ImageView
                        android:layout_width="14dp"
                        android:layout_height="14dp"
                        android:src="@drawable/ic_chevron_down"
                        android:contentDescription="open speed options" />

                </LinearLayout>

                <!-- Settings -->

                <!-- List/transcript -->
                <ImageButton
                    android:id="@+id/btnTranscript"
                    android:layout_width="36dp"
                    android:layout_height="36dp"
                    android:src="@drawable/ic_list"
                    android:background="@drawable/bg_btn_circle_gray"
                    android:contentDescription="transcript" />

            </LinearLayout>

            <!-- ===== SENTENCE SELECTOR (số câu) ===== -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSentenceNumbers"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:paddingBottom="12dp"
                android:clipToPadding="false"
                android:orientation="horizontal" />

            <!-- ===== WORD CARDS (câu bị ẩn) ===== -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="200dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:cardBackgroundColor="#F5F5F5">


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <!-- Play + Replay + Bookmark + Flag -->

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <ImageButton
                            android:id="@+id/btnPlaySentence"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_play_filled"
                            android:background="@drawable/bg_btn_play_blue"
                            android:contentDescription="play sentence"
                            android:layout_marginEnd="8dp" />

                        <ImageButton
                            android:id="@+id/btnReplay"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_replay"
                            android:background="@drawable/bg_btn_circle_gray"
                            android:contentDescription="replay" />

                        <Space
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1" />

                        <ImageButton
                            android:id="@+id/btnBookmark"
                            android:layout_width="36dp"
                            android:layout_height="36dp"
                            android:src="@drawable/ic_bookmark"
                            android:background="@android:color/transparent"
                            android:contentDescription="bookmark"
                            android:layout_marginEnd="4dp" />

                    </LinearLayout>

                    <!-- Word cards: RecyclerView với FlexboxLayoutManager -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvWordCards"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/item_word_card" />
                    <TextView
                        android:id="@+id/tvvietnamese"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Việt Nam"
                        android:visibility="gone"/>

                </LinearLayout>

            </androidx.cardview.widget.CardView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Gõ những gì bạn nghe được:"
                android:textSize="14sp"
                android:textStyle="bold"
                android:textColor="#1A1A1A"
                android:layout_marginStart="16dp"
                android:layout_marginBottom="8dp" />

            <EditText
                android:id="@+id/etInput"
                android:layout_width="match_parent"
                android:layout_height="130dp"
                android:layout_marginStart="16dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="16dp"
                android:background="@drawable/bg_input_box"
                android:padding="12dp"
                android:gravity="top"
                android:hint=""
                android:inputType="textMultiLine"
                android:textSize="14sp"
                android:textColor="#1A1A1A" />

        </LinearLayout>

    </ScrollView>

    <!-- ===== BOTTOM BUTTON ===== -->
    <Button
        android:id="@+id/btnStart"
        android:layout_width="match_parent"
        android:visibility="visible"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:layout_marginTop="8dp"
        android:text="Bắt đầu"
        android:textSize="16sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_btn_blue_fill"
        android:backgroundTint="@null"
        app:backgroundTint="@null"
        android:stateListAnimator="@null" />
    <LinearLayout
        android:id="@+id/layoutButtonBottom"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone"
        android:padding="8dp"
        android:gravity="center_vertical"
        android:background="@color/white">

        <!-- Button Trước (Previous) -->
        <ImageButton
            android:id="@+id/btnPrevious"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_back"
            android:background="@drawable/bg_btn_gray_outline"
            android:foreground="?attr/selectableItemBackground"
            android:contentDescription="Previous" />

        <!-- Button Sau (Next) -->
        <ImageButton
            android:id="@+id/btnNext"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_arrow_forward"
            android:background="@drawable/bg_btn_gray_outline"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="8dp"
            android:contentDescription="Next" />

        <!-- Button Replay -->
        <ImageButton
            android:id="@+id/btnReplay2"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_replay"
            android:background="@drawable/bg_btn_blue_outline"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="8dp"
            android:contentDescription="Replay" />

        <!-- Button Play -->
        <ImageButton
            android:id="@+id/btnPlay"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:src="@drawable/ic_play_arrow"
            android:background="@drawable/bg_btn_blue_fill"
            android:foreground="?attr/selectableItemBackground"
            android:layout_marginStart="8dp"
            android:contentDescription="Play" />

        <!-- Button Kiểm tra -->
        <Button
            android:id="@+id/btnKiemTra"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="2"
            android:text="Kiểm tra"
            android:textColor="@color/white"
            android:background="@drawable/bg_btn_blue_fill"
            android:foreground="?attr/selectableItemBackground"
            android:backgroundTint="@null"
            app:backgroundTint="@null"
            android:layout_marginStart="8dp" />

    </LinearLayout>

</LinearLayout>
