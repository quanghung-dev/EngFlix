<?xml version="1.0" encoding="utf-8"?>

<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardPronunciation"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="5dp"
    android:layout_marginTop="5dp"
    android:layout_marginEnd="5dp"
    android:layout_marginBottom="5dp"
    app:cardBackgroundColor="#FCFCFF"
    app:cardCornerRadius="22dp">

    <LinearLayout

        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="15dp"
        android:paddingTop="15dp"
        android:paddingEnd="15dp"
        android:paddingBottom="16dp">

        
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSentenceNumber"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="2"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="17sp"
                app:backgroundTint="#159CF3"
                app:cornerRadius="22dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPause"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:layout_marginStart="8dp"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:padding="0dp"
                android:text="Ⅱ"
                android:textAllCaps="false"
                android:textColor="@android:color/white"
                android:textSize="19sp"
                android:textStyle="bold"
                app:backgroundTint="#159CF3"
                app:cornerRadius="22dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            

            <Space
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnScore"
                android:layout_width="82dp"
                android:layout_height="38dp"
                android:clickable="false"
                android:focusable="false"
                android:minWidth="0dp"
                android:minHeight="0dp"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:text="🎙 57%"
                android:textAllCaps="false"
                android:textColor="#F04452"
                android:textSize="14sp"
                android:textStyle="bold"
                app:backgroundTint="#FBE4E8"
                app:cornerRadius="20dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            

            

        </LinearLayout>

        
        <TextView
            android:id="@+id/tvEnglishSentence"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:fontFamily="sans"
            android:lineSpacingExtra="3dp"
            android:textSize="16sp"
            android:text="And  come  back  a  failure?"
            android:textStyle="normal" />

        
        <TextView
            android:id="@+id/tvPhonetic"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:fontFamily="sans"
            android:textColor="#A7A8AE"
            android:textSize="16sp"
            tools:text="ænd kʌm bæk ə ˈfeɪljə" />
        <TextView
            android:id="@+id/tvVietnameseMeaning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans"
            android:textColor="#7E7E86"
            android:textSize="16sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="Và trở về trong thất bại sao" />

        
        <View
            android:id="@+id/divider"
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="14dp"
            android:background="#E6E7EB" />

        
        <TextView
            android:id="@+id/tvFeedBack"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:fontFamily="sans"
            android:textColor="#7E7E86"
            android:textSize="16sp"
            android:textStyle="italic"
            android:visibility="gone"
            tools:text="FeedBack" />



        
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnUserRecording"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="16dp"
            android:text="▶  Ghi âm của bạn"
            android:textAllCaps="false"
            android:textColor="#1499F2"
            android:textStyle="bold"
            app:backgroundTint="#E2F2FF"
            app:cornerRadius="12dp"
            android:insetBottom="0dp"
            android:insetTop="0dp" />

        

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>